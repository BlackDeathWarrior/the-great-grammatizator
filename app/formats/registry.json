{
  "formats": [
    {
      "id": "video_package",
      "label": "Video Package",
      "description": "Script, storyboard, scene descriptions, narration, subtitles and visual recommendations. Rendered deterministically; never generative video.",
      "prompt_template": "video_package@v1",
      "output_schema": "video_package.schema.json",
      "constraints": {
        "scenes_min": 4,
        "scenes_max": 8,
        "runtime_target_sec": 240,
        "runtime_tolerance_sec": 45,
        "narration_max_chars_per_scene": 1100,
        "narration_min_chars_per_scene": 550,
        "visual_min_chars": 80
      },
      "model_alias": "long",
      "renderer": "video"
    },
    {
      "id": "linkedin_post",
      "label": "LinkedIn Post",
      "description": "Professional LinkedIn post suitable for publication.",
      "prompt_template": "linkedin_post@v1",
      "output_schema": "linkedin_post.schema.json",
      "constraints": {
        "max_chars": 3000,
        "hashtags_max": 5,
        "min_chars": 1200
      },
      "model_alias": "fast",
      "renderer": "markdown"
    },
    {
      "id": "twitter_x",
      "label": "Twitter / X",
      "description": "Platform-optimised tweet or tweet thread.",
      "prompt_template": "twitter_x@v1",
      "output_schema": "twitter_x.schema.json",
      "constraints": {
        "max_chars_per_tweet": 280,
        "tweets_max": 8,
        "min_chars_per_tweet": 180,
        "tweets_min": 4
      },
      "model_alias": "fast",
      "renderer": "markdown"
    },
    {
      "id": "advisory",
      "label": "Advisory",
      "description": "Structured advisory document.",
      "prompt_template": "advisory@v1",
      "output_schema": "advisory.schema.json",
      "constraints": {
        "max_chars": 8000,
        "recommendations_min": 4,
        "summary_min_chars": 500,
        "recommendation_min_chars": 120
      },
      "model_alias": "long",
      "renderer": "docx"
    },
    {
      "id": "infographic",
      "label": "Infographic",
      "description": "Infographic content, layout recommendations and key messaging.",
      "prompt_template": "infographic@v1",
      "output_schema": "infographic.schema.json",
      "constraints": {
        "panels_min": 3,
        "panels_max": 8,
        "headline_max_chars": 90,
        "caption_min_chars": 110
      },
      "model_alias": "fast",
      "renderer": "json"
    },
    {
      "id": "exec_summary",
      "label": "Executive Summary",
      "description": "Concise executive briefing.",
      "prompt_template": "exec_summary@v1",
      "output_schema": "exec_summary.schema.json",
      "constraints": {
        "max_chars": 4000,
        "key_points_min": 3,
        "key_points_max": 7,
        "key_point_min_chars": 180
      },
      "model_alias": "long",
      "renderer": "docx"
    },
    {
      "id": "presentation",
      "label": "Presentation",
      "description": "Slides with speaker notes.",
      "prompt_template": "presentation@v1",
      "output_schema": "presentation.schema.json",
      "constraints": {
        "slides_min": 4,
        "slides_max": 12,
        "bullets_max_per_slide": 6,
        "speaker_notes_min_chars": 280
      },
      "model_alias": "long",
      "renderer": "pptx"
    }
  ]
}

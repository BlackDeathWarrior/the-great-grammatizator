{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Package",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "duration_sec": {
            "type": "number",
            "minimum": 1
          },
          "source_chunks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "narration",
          "visual",
          "on_screen_text",
          "duration_sec",
          "source_chunks"
        ],
        "additionalProperties": false
      }
    },
    "storyboard_notes": {
      "type": "string"
    },
    "subtitles_srt": {
      "type": "string"
    },
    "visual_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discussion_prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "description": "Every factual assertion, each citing the chunk it came from.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^c\\d+$"
          }
        },
        "required": [
          "text",
          "chunk_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "scenes",
    "storyboard_notes",
    "subtitles_srt",
    "visual_recommendations",
    "claims"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "speaker_notes": {
            "type": "string"
          }
        },
        "required": [
          "heading",
          "bullets",
          "speaker_notes"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "description": "Every factual assertion, each citing the chunk it came from.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^c\\d+$"
          }
        },
        "required": [
          "text",
          "chunk_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "slides",
    "claims"
  ],
  "additionalProperties": false
}

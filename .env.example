# Copy to .env and fill in. Never commit .env.

# --- Providers -------------------------------------------------------------
# Only app/gateway/router.py may reference these. Invariant 5: agents request
# the alias "fast" or "long", never a provider. TC-0901 greps for violations.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_NIM_API_KEY=

# Embeddings call the provider directly, bypassing the LiteLLM router
# (ARCHITECTURE.md §2, TC-0905). Separate key so the bypass is explicit.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Services (use compose service names from inside the app container) -----
# TC-1107: http://qdrant:6333, NOT localhost.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks
DATABASE_URL=postgresql+psycopg://postgres:dev@postgres:5432/app
REDIS_URL=redis://redis:6379

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Limits (ARCHITECTURE.md "Limits") -------------------------------------
VIDEO_MAX_SECONDS=600
QA_MAX_RETRIES=3
PARSE_MAX_RETRIES=2
QA_CONCURRENCY=2
TONE_THRESHOLD=0.75

# --- Storage ---------------------------------------------------------------
STORAGE_DIR=/data/storage
